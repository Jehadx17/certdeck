# Copy to backend/.env (real environment variables take precedence).
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=certdeck.mithaqstay.com,localhost,127.0.0.1
# The single user's API token (the app sends "Authorization: Bearer <token>").
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CERTDECK_API_TOKEN=change-me
ANTHROPIC_API_KEY=sk-ant-...
# Model and automatic background diagrams (on by default)
# CERTDECK_MODEL=claude-opus-5-5
# CERTDECK_AUTO_DIAGRAMS=true
# Where card images are stored (default: backend/media)
CERTDECK_MEDIA_DIR=/var/lib/certdeck/media
# Postgres; leave POSTGRES_DB unset to use SQLite (backend/db.sqlite3) for local dev
POSTGRES_DB=certdeck
POSTGRES_USER=certdeck
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
