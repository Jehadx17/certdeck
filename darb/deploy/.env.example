# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_ALLOWED_HOSTS=darbedu.sa,api,slow,localhost,127.0.0.1
DARB_DOMAIN=darbedu.sa
ANTHROPIC_API_KEY=
POSTGRES_DB=darb
POSTGRES_USER=darb
POSTGRES_PASSWORD=change-me
# Postgres memory: about 25% / 75% of the DB host's RAM.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE=6GB
# Backups to Cloudflare R2 (EU bucket). Set ARCHIVE_MODE=on and start with --profile backup once these are filled in.
ARCHIVE_MODE=off
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_REGION=auto
PGBACKREST_REPO1_S3_URI_STYLE=path
PGBACKREST_REPO1_S3_BUCKET=darb-backups
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_PATH=/pgbackrest
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=change-me-long-random
PGBACKREST_REPO1_RETENTION_FULL=5
PGBACKREST_PG1_PATH=/var/lib/postgresql/data
PGBACKREST_PROCESS_MAX=2
PGBACKREST_START_FAST=y
PGBACKREST_ARCHIVE_ASYNC=y
PGBACKREST_SPOOL_PATH=/var/spool/pgbackrest
# nginx: Cloudflare origin certificate + server block (docs/DARB-OPS.md)
TLS_DIR=./tls
